# Required: TheSportsDB API key (paid/free tier key, NOT the public "3" test key, for production use)
THESPORTSDB_API_KEY=changeme

# Required: comma-separated list of feed access tokens. Multiple values support rotation.
MOTORCAL_TOKENS=changeme-token-one,changeme-token-two

# Required: Cloudflare Tunnel token (from the Cloudflare Zero Trust dashboard,
# "Networks > Tunnels" -- create a tunnel, choose the Docker connector, and
# copy the token shown there; do not paste the tunnel's *certificate*, just
# the token string).
CLOUDFLARE_TUNNEL_TOKEN=changeme-tunnel-token
